# Local workspace paths — copy this file to .env.local and set your paths.
# .env.local is gitignored and never committed.
#
# These are used by Makefile targets that sync artifacts to sibling repos:
#   catalog   → writes log message catalog to LOG_CATALOG
#   openapi   → copies swagger.yaml to OPENAPI_DEST (and optionally STATIC_SYNC_DIR)
#   gear-docs → refreshes AUTOGEN manifest sections in GEAR_DOCS_DIR
#
# Leave empty to skip those sync steps (safe for external contributors).

LOG_CATALOG=
OPENAPI_DEST=
STATIC_SYNC_DIR=
# e.g. GEAR_DOCS_DIR=/Users/you/git/fluxrig.org/docs/reference/gears
GEAR_DOCS_DIR=