# Binaries
bin/
build/
# A stray `go build -o <name>` drops the artifact in the repository root,
# where the rules above do not reach it. scripts/check_no_binaries.sh is the
# backstop for anything these names miss.
/fluxrig
/fluxrig-mixer
/iso8583-tool
*.exe
*.dll
*.so
*.dylib

# Test
*.test
*.out

# Dependencies
vendor/

# OS
.DS_Store

# IDE
.idea/
.vscode/

# Logs
*.log

# Local Data
data/
# *.duckdb (Removed as it's now in ignored data/)


# Python
.venv/
__pycache__/

# Test Artifacts
test/test_logs/
test/e2e/**/work*/
test/e2e/**/work
test/e2e/**/results
test/robot/**/work
test/robot/**/results
test/e2e/10_iso8583/prod/
# The Zig build drops its object beside the source, so every run of the
# regression suite left the tree dirty and the release script refused to start.
test/e2e/**/*.wasm.o
pkg/telemetry/logs/
scratch/

# Unit Test Artifacts
pkg/ingest/comprehensive-mixer/
pkg/ingest/test-mixer/
.cache/

# Local workspace configuration (never commit — contains sibling repo paths)
.env.local

# Temporary
tmp/
.gomod_cache/
test_output*.txt
test_*_out*.txt
*_out.txt
coverage.out
coverage.html
.generated
*.duckdb
dist/

# Claude Code worktrees and session data. Skills are project assets and are
# versioned: a skill that only exists on one machine is not a shared procedure.
.claude/*
!.claude/skills/
