# fluxrig.toml — Rack Agent Configuration Example
# All values shown are their defaults. Override only what you need.
# Full reference: https://fluxrig.org/docs/reference/configuration

# ── Identity & State ─────────────────────────────────────────────────────────
[base]
name       = "node-01"         # Human-readable name (optional; auto-generated if empty)
state_dir  = "./data"          # Directory for passport and WAL files
state_file = "rack.flux"       # Passport filename inside state_dir

# ── Logging ───────────────────────────────────────────────────────────────────
[logging]
level      = "info"            # Levels: debug | info | warn | error
filename   = "logs/fluxrig.log"
max_size_mb  = 100
max_backups  = 7
compress     = true

[logging.throttling]
enabled = true
rate    = 500.0                # Logs per second allowed
burst   = 50

# ── NATS/JetStream (The Snake) ────────────────────────────────────────────────
[snake]
url                       = "nats://localhost:4222"
domain                    = "flux"
stream_name               = "flux-msg"
connect_timeout           = "10s"
reconnect_wait            = "1s"
operation_timeout         = "5s"
subscription_retry_wait   = "200ms"
subscription_retry_attempts = 5
inactive_threshold        = "30s"
convergence_delay         = "100ms"

# Optional TLS (leave empty for plaintext)
# root_ca_file        = "ca.crt"
# tls_cert_file       = "client.crt"
# tls_key_file        = "client.key"
# insecure_skip_verify = false

# ── Persistent Storage ────────────────────────────────────────────────────────
[store]
dir            = "./data"
wal_max_size_mb = 500

# ── Telemetry (Self-Monitoring) ───────────────────────────────────────────────
[telemetry]
service_name   = "flux-rack"
batch_interval = "5s"
base_subject   = "flux.telemetry"
max_batch_size = 512
stream_name    = "flux-telemetry"

[telemetry.metrics]
host_enabled    = false
runtime_enabled = false
bento_enabled   = false
